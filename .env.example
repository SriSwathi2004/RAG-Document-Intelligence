# Copy to .env. No API keys are needed: everything runs locally.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# "sentence-transformers" (real semantic) or "hashing" (offline fallback, lexical only)
EMBEDDING_BACKEND=sentence-transformers
# "ollama" or "extractive" (extractive = no LLM, quotes best sentences)
LLM_PROVIDER=ollama
